/* Google Font */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
scroll-behavior:smooth;
}

body{
background:#050505;
color:#fff;
overflow-x:hidden;
line-height:1.6;
}

/* Navigation */

nav{
position:fixed;
top:0;
left:0;
width:100%;
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 8%;
background:rgba(0,0,0,.65);
backdrop-filter:blur(15px);
z-index:1000;
}

.logo{
font-size:28px;
font-weight:800;
color:#00d9ff;
letter-spacing:2px;
}

.nav-links{
display:flex;
list-style:none;
gap:30px;
}

.nav-links a{
color:#fff;
text-decoration:none;
transition:.3s;
font-weight:500;
}

.nav-links a:hover{
color:#00d9ff;
}

.menu-btn{
display:none;
font-size:28px;
cursor:pointer;
}

/* Hero */

.hero{
height:100vh;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:20px;
background:linear-gradient(135deg,#000,#111,#0a1b22);
}

.hero h1{
font-size:70px;
color:#00d9ff;
text-shadow:0 0 20px #00d9ff;
margin-bottom:15px;
}

.hero h2{
font-size:30px;
margin-bottom:15px;
}

.hero p{
font-size:18px;
color:#ccc;
max-width:650px;
margin:auto;
}

.hero-buttons{
margin-top:35px;
}

.btn{
display:inline-block;
padding:14px 34px;
margin:8px;
background:#00d9ff;
color:#000;
text-decoration:none;
border-radius:50px;
font-weight:700;
transition:.3s;
box-shadow:0 0 20px #00d9ff;
}

.btn:hover{
transform:translateY(-5px);
box-shadow:0 0 35px #00d9ff;
}

.btn2{
background:transparent;
color:#00d9ff;
border:2px solid #00d9ff;
}

/* Sections */

section{
padding:100px 8%;
}

.title{
text-align:center;
font-size:40px;
margin-bottom:40px;
color:#00d9ff;
}

.container{
max-width:1200px;
margin:auto;
}

/* Glass Card */

.card{
background:rgba(255,255,255,.05);
border:1px solid rgba(255,255,255,.1);
backdrop-filter:blur(15px);
padding:30px;
border-radius:20px;
transition:.4s;
}

.card:hover{
transform:translateY(-8px);
border-color:#00d9ff;
}